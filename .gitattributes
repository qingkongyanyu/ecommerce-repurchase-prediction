# 统一行尾与二进制标记
* text=auto

# 源码统一 LF（含 .py/.md/.html/.js/.vue/.scss/.json/.csv）
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.sh text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.joblib binary
*.pkl binary
*.gz binary
